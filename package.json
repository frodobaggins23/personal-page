{
    "name": "personal-page",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "predev": "npm run locales:dev",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest",
        "test:run": "vitest run",
        "prepare": "husky",
        "lint:tailwind": "node scripts/lintTailwind.mjs",
        "locales:key-validation": "node scripts/validateLocaleKeys.mjs",
        "locales:production": "cp -r ./src/locales/production/*.* ./src/locales/ && echo \"Locales ready for production \"",
        "locales:dev": "cp -r ./src/locales/local-boilerplate/*.* ./src/locales/ && echo \"Locales mocked for dev \""
    },
    "dependencies": {
        "@fontsource-variable/ubuntu-sans": "^5.3.0",
        "@fontsource-variable/ubuntu-sans-mono": "^5.3.0",
        "@tailwindcss/vite": "^4.3.5",
        "i18next": "^27.0.1",
        "lucide-react": "^1.70.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.0",
        "react-router": "^7.18.5",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
